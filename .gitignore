# Сборка Maven
/target/

# Python: кэш байт-кода инструментов из tools/. Появляется сам при любом
# запуске скрипта, к проекту не относится и в репозитории только мешает —
# меняется от версии Python и даёт конфликты на пустом месте.
__pycache__/
*.pyc

# Настройки с паролями — у каждого свои; образец без паролей — application.example.yml
/src/main/resources/application.yml

# Файлы, которые портал хранит у себя (отчёты, файлы клиентов, V144), — данные, а не код
/data/

# Настройки IntelliJ IDEA — у каждого свои
/.idea/
