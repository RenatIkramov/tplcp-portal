<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Родительский pom Spring Boot: он задаёт согласованные версии всех
       библиотек, поэтому ниже у зависимостей версии не указываются.
       Если Maven скажет, что такой версии нет — возьмите ту, которую
       предлагает start.spring.io, и поправьте число здесь. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Линия 4.0, последняя версия с исправлениями. Обновление в пределах
         линии безопасно: меняются только исправления, в том числе
         уязвимости Tomcat, Jackson и драйвера PostgreSQL, на которые
         жаловался анализатор зависимостей. Переход на 4.1 — отдельная задача. -->
    <version>4.0.7</version>
    <relativePath/>
  </parent>

  <groupId>com.ahlers</groupId>
  <artifactId>tplcp-portal</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>3PL Customer Portal</name>
  <description>B2B self-service портал 3PL-оператора</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- Веб-слой: контроллеры, встроенный сервер Tomcat, JSON -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JDBC: пул соединений HikariCP, JdbcClient, управление транзакциями -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- Драйвер PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Миграции схемы: применяются при старте приложения (см. application.yml).

         ВАЖНО, почему именно стартер, а не flyway-core напрямую.
         В Spring Boot 4 автоконфигурация разложена по отдельным модулям:
         сама библиотека Flyway на classpath ничего не включает, нужен ещё
         модуль spring-boot-flyway. Без него миграции не выполняются молча,
         без единой ошибки в логе — мы на это уже наступили. Стартер
         подтягивает и библиотеку, и модуль автоконфигурации. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Поддержка диалекта PostgreSQL для Flyway -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Хеширование паролей (BCrypt). Берём только криптографическую часть
         Spring Security: вход, сессия и проверка прав реализованы в портале,
         и тащить ради этого весь каркас безопасности не требуется. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- Тесты -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
