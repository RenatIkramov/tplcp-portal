<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Родительский pom Spring Boot: он задаёт согласованные версии всех
       библиотек, поэтому ниже у зависимостей версии не указываются.
       Если Maven скажет, что такой версии нет — возьмите ту, которую
       предлагает start.spring.io, и поправьте число здесь. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Текущая стабильная линия 4.1. Обновляемся сознательно: в новой линии
         свежее не только Spring, но и всё, что он тянет за собой — Tomcat,
         Jackson, драйвер PostgreSQL, — а исправления уязвимостей выходят
         сначала здесь. Внутри линии (4.1.x) обновление безопасно: только
         исправления. Следующая линия 4.2 пока в разработке (милестоуны),
         на неё переходим, когда выйдет стабильная версия. -->
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.ahlers</groupId>
  <artifactId>tplcp-portal</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>3PL Customer Portal</name>
  <description>B2B self-service портал 3PL-оператора</description>

  <properties>
    <java.version>21</java.version>

    <!-- ===================================================================
         Версии библиотек, которые мы поднимаем впереди родительского pom.

         Родительский pom фиксирует согласованный набор версий, но выходит
         он реже, чем исправления в самих библиотеках. Между выпусками
         Spring Boot в Tomcat и Jackson успевают закрыть уязвимости —
         и сканер (Mend) показывает их как «transitive vulnerable
         dependency», потому что по дереву зависимостей тянется версия
         из родительского pom.

         Эти свойства объявлены в самом родительском pom, поэтому замена
         версии здесь переопределяет её для всего дерева зависимостей:
         и для нашего кода, и для того, что Spring тянет за собой.

         Поднимаем только последнюю цифру — внутри той же линии выходят
         лишь исправления, и совместимость не ломается. Когда выйдет
         следующий Spring Boot 4.1.x, он, скорее всего, привезёт эти же
         версии сам — тогда эти две строки можно убрать и проверить
         сборкой, что версии не откатились назад.

         Проверять так:
             mvn dependency:tree -Dincludes=org.apache.tomcat.embed
             mvn dependency:tree -Dincludes=tools.jackson.core
    =================================================================== -->

    <!-- Встроенный сервер Tomcat. 11.0.24 из родительского pom закрывает
         не все известные уязвимости; 11.0.26 — закрывает.
         Версию 11.0.25 авторы Tomcat в Maven Central не выкладывали. -->
    <tomcat.version>11.0.26</tomcat.version>

    <!-- Jackson (разбор и сборка JSON). Это Jackson 3 — группа
         tools.jackson, а не старая com.fasterxml.jackson; за неё
         отвечает отдельное свойство jackson-2-bom.version, и его
         мы не трогаем. -->
    <jackson-bom.version>3.1.7</jackson-bom.version>

    <!-- Logback (ведение журнала). Родительский pom даёт 1.5.38 — это
         последняя версия линии 1.5, и исправления в неё уже не выходят:
         разработчики перешли на линию 1.6. Авторы называют её прямой
         заменой 1.5.x — тот же SLF4J 2.0.x, та же настройка, тот же
         jakarta.*, поэтому переход сводится к смене версии.

         Закрывает CVE-2026-19880 (путь к файлу журнала можно было вывести
         за пределы папки через значение MDC). Нас это, строго говоря,
         не касалось: уязвим только SiftingAppender с разделением по MDC,
         а портал пишет журнал обычным образом и настройки logback
         у него своей нет — уровни заданы в application.yml. Поднимаем,
         чтобы не держать в проекте заведомо непропатченную библиотеку
         и не разбирать это предупреждение заново при каждом коммите.

         Если в журнале появятся странности — верни 1.5.38 и скажи;
         это единственная правка, которая выходит за линию версий
         родительского pom. -->
    <logback.version>1.6.5</logback.version>

    <!-- Драйвер PostgreSQL. 42.7.13 из родительского pom содержит
         CVE-2026-107315: значение короче объявленной длины драйвер
         добивал не нулями, а байтами ПРЕДЫДУЩИХ запросов — то есть
         в ответ могли попасть данные из чужого запроса. Исправлено
         в 42.7.14.

         Вторая уязвимость того же выпуска (CVE-2026-107314, requireAuth
         не применялся, если в его значении не осталось ни одного способа
         проверки) портала не касается: параметр requireAuth мы
         не задаём. Поднимаем ради первой. -->
    <postgresql.version>42.7.14</postgresql.version>

    <!-- Tomcat 11.0.26 → 11.0.27 приходит с Spring Boot 4.1.2 (родитель
         выше). Сканер показывал на 11.0.26 шесть CVE, из них три важных:
         JNDIRealm принимает неверный пароль (CVE-2026-101296), путаница
         ответов в HTTP/2 (CVE-2026-101356) и в AJP (CVE-2026-103119).
         Ни один из этих путей портал не открывает: вход свой, не JNDIRealm;
         HTTP/2 и AJP в Spring Boot выключены по умолчанию, и мы их
         не включаем. Поднимаем всё равно: это выпуск внутри линии, только
         исправления, и держать известные дыры на пути, который однажды
         включат при развёртывании (HTTP/2 за прокси — обычное дело),
         незачем.

         Jackson 3.1.7 НЕ ПОДНЯТ. На нём сканер показывает CVE-2026-110879
         (обход PolymorphicTypeValidator). Исправленной версии 3.x на
         26.10.2026 нет — и Spring Boot 4.1.2 оставил 3.1.7. Дыра
         срабатывает только при полиморфной десериализации: включённой
         default typing или @JsonTypeInfo на чужих классах. В портале
         ни того ни другого нет (проверено поиском по src/main). Когда
         выйдет исправление — поднимать через свойство версии Jackson
         в родительском pom (имя смотреть там: в Spring Boot 4 оно могло
         смениться).

         Три оставшиеся — json-smart 2.6.0 (CVE-2026-113602),
         android-json (CVE-2026-110974) и ASM (ниже) — приходят только
         со spring-boot-starter-test, областью test. В собранный портал
         они не попадают и работают над нашими же проверками. -->

    <!-- ASM (org.ow2.asm) НАРОЧНО НЕ ПОДНЯТА, хотя сканер показывает
         на неё шесть CVE. Разобрано один раз, чтобы не разбирать заново
         при каждом коммите:

         1. Поднимать некуда. Тот же набор уязвимостей сканер показывает
            на 9.1, 9.5, 9.6 и 9.7.1 — то есть на всех версиях линии.
            Исправленной версии нет.
         2. Все шесть помечены «Insufficient Information»: это заявки без
            разбора, с одинаковым CVSS 5.5.
         3. Суть — переполнение при чтении НАМЕРЕННО испорченного
            .class-файла. ASM по своему контракту разбирает доверенный
            байт-код; портал чужой байт-код не читает вовсе, ASM приходит
            транзитивно и работает только над своими же классами.

         Чем это отличается от драйвера PostgreSQL выше, который мы
         подняли: там дыра лежала на пути живых данных приложения,
         здесь пути к ней нет.

         Если однажды появится исправленная версия — свойство
         называется asm.version, а кто тянет библиотеку, показывает
             mvn dependency:tree -Dincludes=org.ow2.asm -->

    <!-- Playwright — браузер для проверок интерфейса (только тесты).
         Родительский pom эту библиотеку не ведёт, поэтому версия задана
         здесь. Первый запуск скачивает Chromium в кэш пользователя
         (~130 МБ); без сети проверки помечаются пропущенными,
         см. BrowserTestBase. -->
    <playwright.version>1.54.0</playwright.version>
  </properties>

  <dependencies>
    <!-- Веб-слой: контроллеры, встроенный сервер Tomcat, JSON -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JDBC: пул соединений HikariCP, JdbcClient, управление транзакциями -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- Драйвер PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Миграции схемы: применяются при старте приложения (см. application.yml).

         ВАЖНО, почему именно стартер, а не flyway-core напрямую.
         В Spring Boot 4 автоконфигурация разложена по отдельным модулям:
         сама библиотека Flyway на classpath ничего не включает, нужен ещё
         модуль spring-boot-flyway. Без него миграции не выполняются молча,
         без единой ошибки в логе — мы на это уже наступили. Стартер
         подтягивает и библиотеку, и модуль автоконфигурации. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Поддержка диалекта PostgreSQL для Flyway -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Хеширование паролей (BCrypt). Берём только криптографическую часть
         Spring Security: вход, сессия и проверка прав реализованы в портале,
         и тащить ради этого весь каркас безопасности не требуется. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- Чтение и запись .xlsx (шаблон номенклатуры, импорт).

         Версию задаём сами: родительский pom Spring Boot эту библиотеку
         не управляет. POI тянет за собой xmlbeans, commons-compress
         и log4j-api — сканер уязвимостей их увидит, поэтому держим
         версию свежей и обновляем вместе с остальными. -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.5.1</version>
    </dependency>

    <!-- Тесты -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Проверки интерфейса настоящим браузером. Область test: в портал
         эта библиотека не попадает и в поставке её нет. -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
